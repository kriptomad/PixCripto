# Copie este arquivo para ".env" na raiz do projeto e ajuste os valores.
# Variaveis ja definidas no ambiente real (systemd/docker/CI) sempre tem
# prioridade sobre este arquivo - ver app/settings.py.

# Ambiente logico: mainnet | testnet | devnet
PIXCRIPTO_ENV=devnet

# Servidor HTTP (API REST + JSON-RPC + WebSocket + UI de carteira)
PIXCRIPTO_HTTP_HOST=0.0.0.0
PIXCRIPTO_HTTP_PORT=8000
# PIXCRIPTO_TLS_CERT=/caminho/para/fullchain.pem
# PIXCRIPTO_TLS_KEY=/caminho/para/privkey.pem
PIXCRIPTO_CORS_ORIGINS=*

# Rate limiting (anti-spam/DoS)
PIXCRIPTO_RATE_LIMIT_REQUESTS=120
PIXCRIPTO_RATE_LIMIT_WINDOW=60

# Rede P2P
PIXCRIPTO_P2P_HOST=0.0.0.0
PIXCRIPTO_P2P_PORT=9333
PIXCRIPTO_P2P_PEERS=
PIXCRIPTO_DNS_SEEDS=seed1.pixcripto.example,seed2.pixcripto.example
PIXCRIPTO_PEER_DISCOVERY=true

# API estilo exchange (Binance-like) para sites/parceiros se conectarem
PIXCRIPTO_EXCHANGE_API_ENABLED=true

# Conformidade regulatoria (KYC/AML)
PIXCRIPTO_COMPLIANCE_ENABLED=true
PIXCRIPTO_KYC_THRESHOLD_PXC=1000

# Token exigido no header X-Admin-Token para publicar/editar/excluir noticias
# pela UI do site principal (React). DEIXE EM BRANCO para desabilitar a
# escrita do feed de noticias (fail-closed) - gere um valor forte e aleatorio
# antes de usar em producao (ex.: `openssl rand -hex 32`).
PIXCRIPTO_ADMIN_CONTENT_TOKEN=

# Login REAL do Painel de Administracao do site (/admin, React): usuario +
# senha usados APENAS para criar a primeira conta administradora (bootstrap),
# na primeira inicializacao. Depois disso, troque a senha pelo proprio painel
# (aba "Conta"). DEIXE EM BRANCO para manter o login do painel desabilitado
# (fail-closed) ate voce configurar conscientemente.
PIXCRIPTO_ADMIN_USERNAME=
PIXCRIPTO_ADMIN_PASSWORD=
# Duracao da sessao do painel, em segundos (padrao: 12 horas)
PIXCRIPTO_ADMIN_SESSION_TTL_SECONDS=43200

# Housekeeping automatico (limpeza de sessoes expiradas, arquivos orfaos,
# poda de historico antigo, VACUUM do SQLite) - roda em background a cada
# N segundos (padrao: 6 horas), alem de poder ser disparado manualmente
# pelo operador no painel.
PIXCRIPTO_HOUSEKEEPING_INTERVAL_SECONDS=21600
# Quantos dias de historico de preco (para os graficos) sao mantidos
PIXCRIPTO_PRICE_HISTORY_RETENTION_DAYS=180
# Quanto tempo (segundos) os eventos do honeypot ficam retidos em memoria
PIXCRIPTO_HONEYPOT_RETENTION_SECONDS=2592000
